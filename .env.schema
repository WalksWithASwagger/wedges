# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# Varlock is the agent-readable contract for env names and sensitivity only.
# Local values live in ~/.agents/env/values/ and are referenced by path here.
# Deployed values stay in Vercel environment variables.
#
# @defaultRequired=false @defaultSensitive=false
# Shared profile: import only proven cross-repo names. The project values
# file is imported whole so `npm run dev` can load local env through Varlock
# after the app-local .env.local symlink is removed on KK's Mac.
# @import(~/.agents/env/values/.env.shared.local, pick=[ANTHROPIC_API_KEY], allowMissing=true)
# @import(~/.agents/env/values/.env.wedges.local, allowMissing=true)
# ---

# @sensitive
ANTHROPIC_API_KEY=

# @public
ANTHROPIC_MODEL=

# @sensitive
KV_REST_API_TOKEN=

# @public @type=url
KV_REST_API_URL=

# @public @type=enum(development, production, test)
NODE_ENV=

# @sensitive
UPSTASH_REDIS_REST_TOKEN=

# @public @type=url
UPSTASH_REDIS_REST_URL=

# @public @type=url
WEDGES_URL=
